# Copy to .env and fill in. Never commit .env.
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# The database holding the neural_signals and request_payloads tables.
DB_NAME=stg_onex_observability_core_backend

# Optional: point one run at a different database (a restore, say) without
# editing DB_NAME. Takes precedence over DB_NAME.
# LAYER_PROFILE_DB_NAME=
